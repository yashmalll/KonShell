// KonShell для niri — ШАБЛОН. install.sh подставляет пути (@SHELL@ — папка оболочки,
// @USER@ — её папка user/), пишет результат в user/niri.kdl и добавляет в конец
// config.kdl строку include с абсолютным путём к нему. niri объединяет подключённые
// файлы с основным конфигом; одинаковые клавиши здесь перекрывают заданные выше
// в config.kdl. Свои клавиши лучше задавать в config.kdl после строки include.

// Оболочка.
spawn-at-startup "qs" "-p" "@SHELL@"

environment {
    // Qt-приложения берут палитру оболочки через qt6ct (схема user/colors/qt6ct.conf).
    QT_QPA_PLATFORMTHEME "qt6ct"
}

layout {
    // Рабочие столы прозрачные: обои — один слой в заднике (правило ниже), видны
    // сквозь столы и не дублируются под каждым столом в обзоре и при переходах.
    background-color "transparent"
}

layer-rule {
    match namespace="^konshell-wallpaper$"
    place-within-backdrop true
}

// Окно «Настройки KonShell» — плавающее.
window-rule {
    match app-id="^org\\.quickshell$" title="^Настройки KonShell$"
    open-floating true
}

binds {
    Mod+Space hotkey-overlay-title="Лаунчер" { spawn "qs" "-p" "@SHELL@" "ipc" "call" "launcher" "toggle"; }
    Mod+Alt+V hotkey-overlay-title="История буфера обмена" { spawn "qs" "-p" "@SHELL@" "ipc" "call" "clipboard" "toggle"; }
    Mod+Alt+N hotkey-overlay-title="Новая заметка" { spawn "qs" "-p" "@SHELL@" "ipc" "call" "dashboard" "note"; }
    Mod+Shift+E hotkey-overlay-title="Выключение, перезагрузка, выход" { spawn "qs" "-p" "@SHELL@" "ipc" "call" "session" "toggle"; }
    Super+Alt+L hotkey-overlay-title="Заблокировать экран" { spawn "qs" "-p" "@SHELL@" "ipc" "call" "lock" "lock"; }

    // Громкость и яркость — через оболочку: она же показывает индикатор.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "qs" "-p" "@SHELL@" "ipc" "call" "audio" "increase"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "qs" "-p" "@SHELL@" "ipc" "call" "audio" "decrease"; }
    XF86AudioMute allow-when-locked=true { spawn "qs" "-p" "@SHELL@" "ipc" "call" "audio" "toggleMute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "qs" "-p" "@SHELL@" "ipc" "call" "audio" "toggleMicMute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "qs" "-p" "@SHELL@" "ipc" "call" "brightness" "increase"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "qs" "-p" "@SHELL@" "ipc" "call" "brightness" "decrease"; }
}

// Цвета рамок под палитру и курсор — файлы пишет оболочка.
include "@USER@/colors/niri.kdl"
include "@USER@/cursor.kdl"
